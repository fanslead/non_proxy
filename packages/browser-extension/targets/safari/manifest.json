{
  "manifest_version": 3,
  "name": "NonProxy 智能直连",
  "short_name": "NonProxy",
  "version": "0.1.0",
  "description": "只在你主动开启时识别当前标签页需要直连的域名。",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "webRequest"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "scripts": ["background/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "NonProxy 智能直连",
    "default_popup": "popup/popup.html"
  }
}
