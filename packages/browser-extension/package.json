{
  "name": "@nonproxy/browser-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/build.mjs",
    "lint": "tsc -p tsconfig.json --noEmit && node scripts/check-source.mjs",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
