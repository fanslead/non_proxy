{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "lib": ["ES2024", "DOM"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": true,
    "rootDir": "src",
    "outDir": "dist/_compiled",
    "declaration": false,
    "sourceMap": false,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
