<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NonProxy</RootNamespace>
    <AssemblyName>NonProxy.Contracts</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools"
                      PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../../proto/**/*.proto"
              ProtoRoot="../../../proto"
              GrpcServices="None" />
    <Protobuf Update="../../../proto/nonproxy/control/v1/control.proto"
              GrpcServices="Client" />
    <Protobuf Update="../../../proto/nonproxy/adapter/v1/adapter.proto"
              GrpcServices="Client" />
  </ItemGroup>

</Project>
