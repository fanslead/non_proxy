<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:outbounds="using:NonProxy.Desktop.Core.Features.Outbounds"
             xmlns:control="using:NonProxy.Desktop.Core.Services.Control"
             x:Name="Root"
             x:Class="NonProxy.Desktop.Core.Features.Outbounds.OutboundsView"
             x:DataType="outbounds:OutboundsViewModel">
    <ScrollViewer>
        <StackPanel Margin="40"
                    MaxWidth="960"
                    Spacing="24">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock Theme="{StaticResource NpPageTitle}"
                               Text="网络出口" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="先检查代理握手，再用自有签名探针确认本次直连或代理路径的公网来源地址。" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="选择默认代理后，未命中直连规则的流量才会走该代理；修改需等待系统组件确认后生效。" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource NpSecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Content="重新检查"
                        AutomationProperties.Name="重新检查网络出口" />
            </Grid>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="14">
                    <TextBlock Theme="{StaticResource NpSectionTitle}"
                               Text="添加本地代理" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="只需填写本机代理监听信息；账号和密码会存入系统凭据库，不会写入规则数据库。" />
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="16"
                          RowSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="配置标识" />
                            <TextBox Theme="{StaticResource NpTextBox}"
                                     Text="{Binding OutboundId}"
                                     PlaceholderText="例如：local-proxy"
                                     AutomationProperties.Name="代理配置标识" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Spacing="6">
                            <TextBlock Text="代理类型" />
                            <ComboBox ItemsSource="{Binding KindOptions}"
                                      SelectedItem="{Binding SelectedKind}"
                                      AutomationProperties.Name="代理类型">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="outbounds:OutboundKindOption">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <TextBlock Theme="{StaticResource NpMutedText}"
                                                       Text="{Binding CapabilityHint}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Spacing="6">
                            <TextBlock Text="服务器地址" />
                            <TextBox Theme="{StaticResource NpTextBox}"
                                     Text="{Binding Host}"
                                     PlaceholderText="例如：127.0.0.1"
                                     AutomationProperties.Name="代理服务器地址" />
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Spacing="6">
                            <TextBlock Text="端口" />
                            <TextBox Theme="{StaticResource NpTextBox}"
                                     Text="{Binding Port}"
                                     PlaceholderText="例如：1080"
                                     AutomationProperties.Name="代理服务器端口" />
                        </StackPanel>
                        <StackPanel Grid.Row="2"
                                    Spacing="6">
                            <TextBlock Text="账号（可选）" />
                            <TextBox Theme="{StaticResource NpTextBox}"
                                     Text="{Binding Username}"
                                     AutomationProperties.Name="代理账号" />
                        </StackPanel>
                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Spacing="6">
                            <TextBlock Text="密码（可选）" />
                            <TextBox Theme="{StaticResource NpTextBox}"
                                     Text="{Binding Password}"
                                     PasswordChar="●"
                                     AutomationProperties.Name="代理密码" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Foreground="{DynamicResource NpDangerBrush}"
                               Text="{Binding ValidationMessage}" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="{Binding OperationMessage}" />
                    <Button HorizontalAlignment="Left"
                            Theme="{StaticResource NpPrimaryButton}"
                            Command="{Binding ImportCommand}"
                            Content="安全保存代理"
                            AutomationProperties.Name="安全保存代理配置" />
                </StackPanel>
            </Border>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Theme="{StaticResource NpSectionTitle}"
                                   Text="公网出口验证" />
                        <TextBlock Theme="{StaticResource NpMutedText}"
                                   Text="远端只观察本次探针连接的来源 IP；结果不代表其他时间、协议或用户目标必然使用同一路径。" />
                        <TextBlock Theme="{StaticResource NpMutedText}"
                                   Text="{Binding ExitVerificationAvailabilityMessage}" />
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource NpBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">
                        <Grid ColumnDefinitions="2*,2*,1.4*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold"
                                           Text="物理直连" />
                                <TextBlock Theme="{StaticResource NpMutedText}"
                                           Text="绕过代理出口的独立验证" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Spacing="3">
                                <TextBlock Text="{Binding DirectExitStatusLabel}" />
                                <TextBlock Theme="{StaticResource NpMutedText}"
                                           Text="签名公网来源地址" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Spacing="3">
                                <TextBlock Text="{Binding DirectExitCheckedLabel}" />
                                <TextBlock Theme="{StaticResource NpMutedText}"
                                           Text="本地验证时间" />
                            </StackPanel>
                            <Button Grid.Column="3"
                                    Theme="{StaticResource NpSecondaryButton}"
                                    Command="{Binding VerifyDirectExitCommand}"
                                    Content="验证直连出口"
                                    AutomationProperties.Name="验证物理直连公网出口" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Theme="{StaticResource NpSectionTitle}"
                                       Text="默认路由" />
                            <TextBlock Theme="{StaticResource NpMutedText}"
                                       Text="{Binding DefaultRouteSummary}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Theme="{StaticResource NpSecondaryButton}"
                                Command="{Binding SetDirectCommand}"
                                Content="恢复默认直连"
                                AutomationProperties.Name="恢复未命中流量默认直连" />
                    </Grid>
                    <Grid ColumnDefinitions="1.8*,1.8*,1.4*,1.8*,Auto"
                          ColumnSpacing="16">
                        <TextBlock FontWeight="SemiBold"
                                   Text="名称" />
                        <TextBlock Grid.Column="1"
                                   FontWeight="SemiBold"
                                   Text="端点" />
                        <TextBlock Grid.Column="2"
                                   FontWeight="SemiBold"
                                   Text="握手状态" />
                        <TextBlock Grid.Column="3"
                                   FontWeight="SemiBold"
                                   Text="签名公网出口" />
                    </Grid>
                    <ItemsControl x:Name="OutboundItemsList"
                                  ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="control:OutboundListItem">
                                <Grid ColumnDefinitions="1.8*,1.8*,1.4*,1.8*,Auto"
                                      ColumnSpacing="16"
                                      Margin="0,8">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Theme="{StaticResource NpMutedText}"
                                                   FontSize="11"
                                                   Text="{Binding Kind}" />
                                        <TextBlock Foreground="{DynamicResource NpBrandBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DefaultLabel}" />
                                        <TextBlock Theme="{StaticResource NpMutedText}"
                                                   FontSize="11"
                                                   Text="{Binding DefaultEligibilityLabel}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Endpoint}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2"
                                                Spacing="3">
                                        <TextBlock Text="{Binding Health}" />
                                        <TextBlock Theme="{StaticResource NpMutedText}"
                                                   Text="{Binding LatencyLabel}" />
                                        <TextBlock Theme="{StaticResource NpMutedText}"
                                                   FontSize="11"
                                                   Text="{Binding LastCheckedLabel}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3"
                                                Spacing="3">
                                        <TextBlock Text="{Binding ExitStatusLabel}" />
                                        <TextBlock Theme="{StaticResource NpMutedText}"
                                                   FontSize="11"
                                                   Text="{Binding ExitCheckedLabel}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4"
                                                Spacing="6">
                                        <Button VerticalAlignment="Center"
                                                Theme="{StaticResource NpSecondaryButton}"
                                                Command="{ReflectionBinding DataContext.SetDefaultCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanSetAsDefault}"
                                                Content="设为默认"
                                                AutomationProperties.Name="设为默认代理" />
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <Button VerticalAlignment="Center"
                                                    Theme="{StaticResource NpSecondaryButton}"
                                                    Command="{ReflectionBinding DataContext.TestCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="测试握手"
                                                    AutomationProperties.Name="测试代理握手" />
                                            <Button VerticalAlignment="Center"
                                                    Theme="{StaticResource NpSecondaryButton}"
                                                    Command="{ReflectionBinding DataContext.VerifyExitCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Content="验证出口"
                                                    AutomationProperties.Name="验证代理公网出口" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="“测试握手”只验证代理可连接；“验证出口”才会保存带签名的公网来源回执。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
