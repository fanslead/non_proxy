<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:outbounds="using:NonProxy.Desktop.Core.Features.Outbounds"
             xmlns:control="using:NonProxy.Desktop.Core.Services.Control"
             x:Class="NonProxy.Desktop.Core.Features.Outbounds.OutboundsView"
             x:DataType="outbounds:OutboundsViewModel">
    <ScrollViewer>
        <StackPanel Margin="40"
                    MaxWidth="960"
                    Spacing="24">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock Theme="{StaticResource NpPageTitle}"
                               Text="网络出口" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="查看直连、本机代理和可选上游出口的健康状态；凭据不会显示在这里。" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource NpSecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Content="重新检查"
                        AutomationProperties.Name="重新检查网络出口" />
            </Grid>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="14">
                    <TextBlock Theme="{StaticResource NpSectionTitle}"
                               Text="添加本地代理" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="只需填写本机代理监听信息；账号和密码会存入系统凭据库，不会写入规则数据库。" />
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="16"
                          RowSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="配置标识" />
                            <TextBox Theme="{StaticResource NpTextBox}"
                                     Text="{Binding OutboundId}"
                                     PlaceholderText="例如：local-proxy"
                                     AutomationProperties.Name="代理配置标识" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Spacing="6">
                            <TextBlock Text="代理类型" />
                            <ComboBox ItemsSource="{Binding KindOptions}"
                                      SelectedItem="{Binding SelectedKind}"
                                      AutomationProperties.Name="代理类型">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="outbounds:OutboundKindOption">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <TextBlock Theme="{StaticResource NpMutedText}"
                                                       Text="{Binding CapabilityHint}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Spacing="6">
                            <TextBlock Text="服务器地址" />
                            <TextBox Theme="{StaticResource NpTextBox}"
                                     Text="{Binding Host}"
                                     PlaceholderText="例如：127.0.0.1"
                                     AutomationProperties.Name="代理服务器地址" />
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Spacing="6">
                            <TextBlock Text="端口" />
                            <TextBox Theme="{StaticResource NpTextBox}"
                                     Text="{Binding Port}"
                                     PlaceholderText="例如：1080"
                                     AutomationProperties.Name="代理服务器端口" />
                        </StackPanel>
                        <StackPanel Grid.Row="2"
                                    Spacing="6">
                            <TextBlock Text="账号（可选）" />
                            <TextBox Theme="{StaticResource NpTextBox}"
                                     Text="{Binding Username}"
                                     AutomationProperties.Name="代理账号" />
                        </StackPanel>
                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Spacing="6">
                            <TextBlock Text="密码（可选）" />
                            <TextBox Theme="{StaticResource NpTextBox}"
                                     Text="{Binding Password}"
                                     PasswordChar="●"
                                     AutomationProperties.Name="代理密码" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Foreground="{DynamicResource NpDangerBrush}"
                               Text="{Binding ValidationMessage}" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="{Binding OperationMessage}" />
                    <Button HorizontalAlignment="Left"
                            Theme="{StaticResource NpPrimaryButton}"
                            Command="{Binding ImportCommand}"
                            Content="安全保存代理"
                            AutomationProperties.Name="安全保存代理配置" />
                </StackPanel>
            </Border>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="2*,*,3*,*"
                          ColumnSpacing="16">
                        <TextBlock FontWeight="SemiBold"
                                   Text="名称" />
                        <TextBlock Grid.Column="1"
                                   FontWeight="SemiBold"
                                   Text="类型" />
                        <TextBlock Grid.Column="2"
                                   FontWeight="SemiBold"
                                   Text="端点" />
                        <TextBlock Grid.Column="3"
                                   FontWeight="SemiBold"
                                   Text="健康状态" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="control:OutboundListItem">
                                <Grid ColumnDefinitions="2*,*,3*,*"
                                      ColumnSpacing="16"
                                      Margin="0,8">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Kind}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Endpoint}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Health}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="控制服务未连接时不会猜测或伪造出口状态。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
