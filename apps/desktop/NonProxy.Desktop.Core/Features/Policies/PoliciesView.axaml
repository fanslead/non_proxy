<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:policies="using:NonProxy.Desktop.Core.Features.Policies"
             xmlns:control="using:NonProxy.Desktop.Core.Services.Control"
             x:Class="NonProxy.Desktop.Core.Features.Policies.PoliciesView"
             x:Name="Root"
             x:DataType="policies:PoliciesViewModel">
    <ScrollViewer>
        <StackPanel Margin="40"
                    MaxWidth="960"
                    Spacing="24">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock Theme="{StaticResource NpPageTitle}"
                               Text="全部规则" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="{Binding ActiveSnapshotLabel}" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="{Binding OperationMessage}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource NpSecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Content="刷新"
                        AutomationProperties.Name="刷新全部规则" />
            </Grid>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel Spacing="5">
                            <TextBlock Theme="{StaticResource NpSectionTitle}"
                                       Text="恢复上一个配置" />
                            <TextBlock Theme="{StaticResource NpMutedText}"
                                       Text="{Binding RestorePreviousDetail}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="RequestRestorePreviousButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Theme="{StaticResource NpSecondaryButton}"
                                Command="{Binding RequestRestorePreviousCommand}"
                                Content="选择恢复"
                                IsEnabled="{Binding CanRestorePrevious}"
                                AutomationProperties.Name="恢复上一个已生效配置" />
                    </Grid>

                    <Border x:Name="RestorePreviousConfirmation"
                            Padding="14"
                            CornerRadius="9"
                            BorderBrush="{DynamicResource NpWarningBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding IsRestoreConfirmationVisible}">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold"
                                       Text="确认恢复上一个已生效配置？" />
                            <TextBlock Theme="{StaticResource NpMutedText}"
                                       Text="这会创建新的待确认快照，并同时恢复当时的默认路由。当前规则草稿不会被删除；Provider 确认前不能视为已经恢复。"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">
                                <Button Theme="{StaticResource NpSecondaryButton}"
                                        Command="{Binding ConfirmRestorePreviousCommand}"
                                        Content="确认恢复"
                                        AutomationProperties.Name="确认恢复上一个已生效配置" />
                                <Button Theme="{StaticResource NpSecondaryButton}"
                                        Command="{Binding CancelRestorePreviousCommand}"
                                        Content="取消"
                                        AutomationProperties.Name="取消恢复上一个已生效配置" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="2*,*,2*,*,*,Auto"
                          ColumnSpacing="12">
                        <TextBlock FontWeight="SemiBold"
                                   Text="名称" />
                        <TextBlock Grid.Column="1"
                                   FontWeight="SemiBold"
                                   Text="范围" />
                        <TextBlock Grid.Column="2"
                                   FontWeight="SemiBold"
                                   Text="匹配目标" />
                        <TextBlock Grid.Column="3"
                                   FontWeight="SemiBold"
                                   Text="动作" />
                        <TextBlock Grid.Column="4"
                                   FontWeight="SemiBold"
                                   Text="状态" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="control:PolicyListItem">
                                <Grid ColumnDefinitions="2*,*,2*,*,*,Auto"
                                      ColumnSpacing="12"
                                      Margin="0,8">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ScopeLabel}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding MatchValue}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ActionLabel}" />
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding StateLabel}" />
                                    <Button Grid.Column="5"
                                            Theme="{StaticResource NpSecondaryButton}"
                                            Command="{ReflectionBinding DataContext.DeleteCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="删除"
                                            AutomationProperties.Name="删除规则" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="未列出规则时，表示控制服务没有返回已保存的策略。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
