<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:policies="using:NonProxy.Desktop.Core.Features.Policies"
             xmlns:control="using:NonProxy.Desktop.Core.Services.Control"
             x:Class="NonProxy.Desktop.Core.Features.Policies.PoliciesView"
             x:Name="Root"
             x:DataType="policies:PoliciesViewModel">
    <ScrollViewer>
        <StackPanel Margin="40"
                    MaxWidth="960"
                    Spacing="24">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock Theme="{StaticResource NpPageTitle}"
                               Text="全部规则" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="{Binding ActiveSnapshotLabel}" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="{Binding OperationMessage}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Theme="{StaticResource NpSecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Content="刷新"
                        AutomationProperties.Name="刷新全部规则" />
            </Grid>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="2*,*,2*,*,*,Auto"
                          ColumnSpacing="12">
                        <TextBlock FontWeight="SemiBold"
                                   Text="名称" />
                        <TextBlock Grid.Column="1"
                                   FontWeight="SemiBold"
                                   Text="范围" />
                        <TextBlock Grid.Column="2"
                                   FontWeight="SemiBold"
                                   Text="匹配目标" />
                        <TextBlock Grid.Column="3"
                                   FontWeight="SemiBold"
                                   Text="动作" />
                        <TextBlock Grid.Column="4"
                                   FontWeight="SemiBold"
                                   Text="状态" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="control:PolicyListItem">
                                <Grid ColumnDefinitions="2*,*,2*,*,*,Auto"
                                      ColumnSpacing="12"
                                      Margin="0,8">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ScopeLabel}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding MatchValue}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ActionLabel}" />
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding StateLabel}" />
                                    <Button Grid.Column="5"
                                            Theme="{StaticResource NpSecondaryButton}"
                                            Command="{ReflectionBinding DataContext.DeleteCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="删除"
                                            AutomationProperties.Name="删除规则" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="未列出规则时，表示控制服务没有返回已保存的策略。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
