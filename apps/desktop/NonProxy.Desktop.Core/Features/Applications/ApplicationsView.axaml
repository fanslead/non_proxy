<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:applications="using:NonProxy.Desktop.Core.Features.Applications"
             xmlns:control="using:NonProxy.Desktop.Core.Services.Control"
             x:Class="NonProxy.Desktop.Core.Features.Applications.ApplicationsView"
             x:Name="Root"
             x:DataType="applications:ApplicationsViewModel">
    <ScrollViewer>
        <StackPanel Margin="40"
                    MaxWidth="960"
                    Spacing="24">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="20">
                <StackPanel Spacing="6">
                    <TextBlock Theme="{StaticResource NpPageTitle}"
                               Text="应用直连" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="选择你认识的应用即可，无需查找它访问了哪些域名，也无需填写应用路径或身份 ID。" />
                </StackPanel>
                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Theme="{StaticResource NpSecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Content="刷新应用"
                        AutomationProperties.Name="刷新可选择的应用" />
            </Grid>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel Spacing="5">
                            <TextBlock Theme="{StaticResource NpSectionTitle}"
                                       Text="选择应用" />
                            <TextBlock Theme="{StaticResource NpMutedText}"
                                       Text="正在运行的应用会排在前面；也可以通过系统文件选择器选择其他软件。" />
                        </StackPanel>
                        <Button x:Name="ChooseApplicationButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Theme="{StaticResource NpPrimaryButton}"
                                Command="{Binding ChooseCommand}"
                                Content="从应用程序中选择"
                                AutomationProperties.Name="从应用程序中选择直连应用" />
                    </Grid>

                    <TextBox x:Name="ApplicationSearchBox"
                             Theme="{StaticResource NpTextBox}"
                             Text="{Binding SearchText}"
                             PlaceholderText="按应用名称搜索"
                             AutomationProperties.Name="搜索可选择的应用" />

                    <ItemsControl x:Name="AvailableApplicationsList"
                                  ItemsSource="{Binding AvailableApplications}"
                                  IsVisible="{Binding HasAvailableApplications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="applications:ApplicationCatalogItem">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="16"
                                      Margin="0,7">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}" />
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6">
                                            <TextBlock Foreground="{DynamicResource NpSuccessBrush}"
                                                       Text="{Binding StateLabel}" />
                                            <TextBlock Theme="{StaticResource NpMutedText}"
                                                       Text="·" />
                                            <TextBlock Theme="{StaticResource NpMutedText}"
                                                       Text="{Binding IdentityAssuranceLabel}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Theme="{StaticResource NpSecondaryButton}"
                                            Command="{ReflectionBinding DataContext.AddCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding ActionLabel}"
                                            AutomationProperties.Name="将应用设为直连" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Padding="16"
                            CornerRadius="8"
                            Background="{DynamicResource NpCanvasBrush}"
                            IsVisible="{Binding HasNoAvailableApplications}">
                        <StackPanel Spacing="10">
                            <ProgressBar x:Name="ApplicationCatalogProgress"
                                         Height="4"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding IsBusy}"
                                         AutomationProperties.Name="正在校验本机应用身份" />
                            <TextBlock Theme="{StaticResource NpMutedText}"
                                       Text="{Binding CatalogMessage}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="{Binding OperationMessage}" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="规则应用后，可在“活动记录”核对命中规则和实际出口路径。" />
                </StackPanel>
            </Border>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="14">
                    <TextBlock Theme="{StaticResource NpSectionTitle}"
                               Text="已配置应用" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="control:PolicyListItem">
                                <Grid ColumnDefinitions="2*,*,Auto"
                                      ColumnSpacing="16"
                                      Margin="0,8">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Name}" />
                                        <TextBlock Theme="{StaticResource NpMutedText}"
                                                   Text="全部网络请求直连" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Text="{Binding StateLabel}" />
                                    <Button Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Theme="{StaticResource NpSecondaryButton}"
                                            Command="{ReflectionBinding DataContext.DeleteCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="删除"
                                            AutomationProperties.Name="删除应用规则" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="未列出应用时，表示尚未保存应用规则。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
