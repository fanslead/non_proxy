<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:applications="using:NonProxy.Desktop.Core.Features.Applications"
             xmlns:control="using:NonProxy.Desktop.Core.Services.Control"
             x:Class="NonProxy.Desktop.Core.Features.Applications.ApplicationsView"
             x:Name="Root"
             x:DataType="applications:ApplicationsViewModel">
    <ScrollViewer>
        <StackPanel Margin="40"
                    MaxWidth="960"
                    Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Theme="{StaticResource NpPageTitle}"
                           Text="应用直连" />
                <TextBlock Theme="{StaticResource NpMutedText}"
                           Text="应用规则不要求你知道软件访问了哪些域名；匹配到该应用的流量统一按规则处理。" />
            </StackPanel>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="14">
                    <TextBlock Theme="{StaticResource NpSectionTitle}"
                               Text="添加应用" />
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="显示名称" />
                            <TextBox Theme="{StaticResource NpTextBox}"
                                     Text="{Binding ApplicationName}"
                                     PlaceholderText="例如：公司办公软件"
                                     AutomationProperties.Name="应用显示名称" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Spacing="6">
                            <TextBlock Text="应用身份" />
                            <TextBox Theme="{StaticResource NpTextBox}"
                                     Text="{Binding ApplicationIdentity}"
                                     PlaceholderText="Bundle ID、包身份或签名标识"
                                     AutomationProperties.Name="应用身份标识" />
                        </StackPanel>
                    </Grid>
                    <Button HorizontalAlignment="Left"
                            Theme="{StaticResource NpPrimaryButton}"
                            Command="{Binding AddCommand}"
                            Content="添加直连应用"
                            AutomationProperties.Name="添加直连应用规则" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="{Binding OperationMessage}" />
                </StackPanel>
            </Border>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="14">
                    <TextBlock Theme="{StaticResource NpSectionTitle}"
                               Text="已配置应用" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="control:PolicyListItem">
                                <Grid ColumnDefinitions="2*,3*,*,Auto"
                                      ColumnSpacing="16"
                                      Margin="0,8">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MatchValue}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StateLabel}" />
                                    <Button Grid.Column="3"
                                            Theme="{StaticResource NpSecondaryButton}"
                                            Command="{ReflectionBinding DataContext.DeleteCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="删除"
                                            AutomationProperties.Name="删除应用规则" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="未列出应用时，表示尚未保存应用规则。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
