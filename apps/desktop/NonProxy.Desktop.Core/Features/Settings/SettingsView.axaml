<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:NonProxy.Desktop.Core.Features.Settings"
             x:Class="NonProxy.Desktop.Core.Features.Settings.SettingsView"
             x:DataType="settings:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="40"
                    MaxWidth="960"
                    Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Theme="{StaticResource NpPageTitle}"
                           Text="设置" />
                <TextBlock Theme="{StaticResource NpMutedText}"
                           Text="管理本机桌面体验；网络规则和后台服务具有独立生命周期。" />
            </StackPanel>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="18">
                    <TextBlock Theme="{StaticResource NpSectionTitle}"
                               Text="外观" />
                    <Grid ColumnDefinitions="180,*">
                        <TextBlock VerticalAlignment="Center"
                                   Text="主题" />
                        <ComboBox Grid.Column="1"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding Theme}"
                                  AutomationProperties.Name="应用主题" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="10">
                    <TextBlock Theme="{StaticResource NpSectionTitle}"
                               Text="窗口与后台" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="关闭主窗口会把界面隐藏到菜单栏或通知区域。使用托盘菜单可恢复窗口或只退出桌面界面；已激活规则由独立后台服务继续执行。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="10">
                    <TextBlock Theme="{StaticResource NpSectionTitle}"
                               Text="隐私" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="决策记录和诊断包只保存在本机。诊断导出采用严格脱敏且不会自动上传；当前版本不提供会让必要安全证据消失的伪关闭开关。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <Button Theme="{StaticResource NpPrimaryButton}"
                        Command="{Binding SaveCommand}"
                        Content="保存设置"
                        AutomationProperties.Name="保存桌面设置" />
                <TextBlock VerticalAlignment="Center"
                           Theme="{StaticResource NpMutedText}"
                           Text="{Binding OperationMessage}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
