<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:learning="using:NonProxy.Desktop.Core.Features.Learning"
             x:Class="NonProxy.Desktop.Core.Features.Learning.LearningView"
             x:DataType="learning:LearningViewModel">
    <ScrollViewer>
        <StackPanel Margin="40"
                    MaxWidth="960"
                    Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Theme="{StaticResource NpPageTitle}"
                           Text="智能学习" />
                <TextBlock Theme="{StaticResource NpMutedText}"
                           Text="临时观察你主动使用的软件和网站，生成候选规则；未经确认不会自动放行。" />
            </StackPanel>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="6">
                            <TextBlock Theme="{StaticResource NpSectionTitle}"
                                       Text="学习会话" />
                            <TextBlock Theme="{StaticResource NpMutedText}"
                                       Text="{Binding Status.Detail}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding Status.CandidateCount, StringFormat='候选规则：{0}'}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <Button Theme="{StaticResource NpPrimaryButton}"
                                Command="{Binding StartCommand}"
                                Content="开始学习"
                                AutomationProperties.Name="开始智能学习" />
                        <Button Theme="{StaticResource NpSecondaryButton}"
                                Command="{Binding StopCommand}"
                                Content="停止学习"
                                AutomationProperties.Name="停止智能学习" />
                        <Button Theme="{StaticResource NpSecondaryButton}"
                                Command="{Binding RefreshCommand}"
                                Content="刷新状态"
                                AutomationProperties.Name="刷新学习状态" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Theme="{StaticResource NpCard}">
                <StackPanel Spacing="10">
                    <TextBlock Theme="{StaticResource NpSectionTitle}"
                               Text="隐私边界" />
                    <TextBlock Theme="{StaticResource NpMutedText}"
                               Text="仅采集做出网络决策所需的应用身份、域名、目标地址和时间，不读取网页正文。历史记录可在设置中关闭。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
