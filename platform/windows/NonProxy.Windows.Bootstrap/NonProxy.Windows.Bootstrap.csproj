<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.26100.0</TargetFrameworks>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <RootNamespace>NonProxy.Windows.Bootstrap</RootNamespace>
    <AssemblyName>NonProxy.Windows.Bootstrap</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../NonProxy.Windows.Security/NonProxy.Windows.Security.csproj" />
    <AssemblyMetadata Include="NonProxyWindowsPublisherCertificateSha256"
                      Value="$(NonProxyWindowsPublisherCertificateSha256)" />
  </ItemGroup>

  <Target Name="RejectPortableWindowsBootstrapPublish"
          BeforeTargets="Publish"
          Condition="'$(TargetFramework)' == 'net10.0'">
    <Error Text="Windows Bootstrap 发布必须指定 net10.0-windows10.0.26100.0。" />
  </Target>

  <Target Name="RequireWindowsPublisherIdentity"
          BeforeTargets="Publish"
          Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100.0'">
    <PropertyGroup>
      <_PublisherIdentityValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(NonProxyWindowsPublisherCertificateSha256)', '^[0-9A-Fa-f]{64}$'))</_PublisherIdentityValid>
    </PropertyGroup>
    <Error Condition="'$(_PublisherIdentityValid)' != 'True'"
           Text="Windows Bootstrap 发布必须通过 NonProxyWindowsPublisherCertificateSha256 编译固定发布者证书 SHA-256。" />
    <Error Condition="'$(PublishSingleFile)' != 'true' or '$(SelfContained)' != 'true' or '$(IncludeNativeLibrariesForSelfExtract)' != 'true'"
           Text="Windows Bootstrap 必须以包含原生运行时的 self-contained single-file 方式发布。" />
    <Error Condition="'$(RuntimeIdentifier)' != 'win-x64' and '$(RuntimeIdentifier)' != 'win-arm64'"
           Text="Windows Bootstrap 发布必须显式选择 win-x64 或 win-arm64 RID。" />
  </Target>

  <Target Name="WriteWindowsPublisherIdentity"
          AfterTargets="Publish"
          Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100.0'">
    <WriteLinesToFile File="$(PublishDir)nonproxy-publisher-certificate-sha256.txt"
                      Lines="$([System.String]::Copy('$(NonProxyWindowsPublisherCertificateSha256)').ToLowerInvariant())"
                      Overwrite="true"
                      Encoding="UTF-8" />
  </Target>

</Project>
