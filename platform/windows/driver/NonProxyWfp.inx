[Version]
Signature = "$WINDOWS NT$"
Class = WFPCALLOUTS
ClassGuid = {57465043-616C-6C6F-7574-5F636C617373}
Provider = %ProviderName%
DriverVer = 08/02/2026,0.0.1.0
CatalogFile = NonProxyWfp.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13
DriverCopyFiles = 13

[DefaultInstall.NTamd64]
CopyFiles = DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService = NonProxyWfp,,ServiceInstall

[DefaultInstall.NTarm64]
CopyFiles = DriverCopyFiles

[DefaultInstall.NTarm64.Services]
AddService = NonProxyWfp,,ServiceInstall

[DriverCopyFiles]
NonProxyWfp.sys

[ServiceInstall]
DisplayName = %ServiceName%
Description = %ServiceDescription%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\NonProxyWfp.sys
Dependencies = BFE

[SourceDisksFiles]
NonProxyWfp.sys = 1

[SourceDisksNames]
1 = %DiskName%,,,

[Strings]
ProviderName = "NonProxy"
ServiceName = "NonProxy WFP Callout Driver"
ServiceDescription = "执行 TCP/DNS 重定向与有界 UDP 数据报搬运的最小内核组件"
DiskName = "NonProxy WFP Driver"
