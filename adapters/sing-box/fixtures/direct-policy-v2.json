{
  "format_version": 2,
  "revision": 1,
  "rules": [
    {
      "id": "app-chat",
      "action": "direct",
      "selector": {
        "kind": "application",
        "selector_version": 1,
        "platform": "macos",
        "path_kind": "bundle",
        "value": "/Applications/Chat.app"
      }
    },
    {
      "id": "site-example",
      "action": "direct",
      "selector": {
        "kind": "domain",
        "match_kind": "suffix",
        "value": "example.com"
      }
    }
  ]
}
