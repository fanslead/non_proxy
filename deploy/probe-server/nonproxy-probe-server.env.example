# 该文件只保存路径和非敏感运行参数，不得内嵌 TLS 或 Ed25519 私钥。
NONPROXY_PROBE_BIND=[::]:443
NONPROXY_PROBE_TLS_CERT=/etc/nonproxy/probe-server/tls-chain.pem
NONPROXY_PROBE_TLS_KEY=/etc/nonproxy/probe-server/tls-key.pem
NONPROXY_PROBE_SIGNING_KEY=/etc/nonproxy/probe-server/signing-key-v1.bin
NONPROXY_PROBE_MAX_CONNECTIONS=1024
